# Backend Moov Events Scan

# -- Serveur ------------------------------------------------------------------
PORT=3211
NODE_ENV=development
APP_ENV=prod

# -- Backend moov-events (validation des QR) -----------------------------------
# En prod, les deux backends tournent sur le meme serveur : localhost suffit.
MOOV_EVENTS_INTERNAL_URL=http://localhost:3210
MOOV_EVENTS_INTERNAL_URL_TEST=http://localhost:3310
# Doit correspondre exactement a SCAN_SERVICE_SECRET du backend moov-events.
SCAN_SERVICE_SECRET=change-me-in-production

# -- CORS -----------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
